# Environment Configuration Example
# Do not place real production secrets here.

# Database URL for PostgreSQL connection
DATABASE_URL="postgresql://user:password@localhost:5432/fundsroom"

# JWT Secret for signing tokens (Must be a long random string in production)
JWT_SECRET="development_secret_do_not_use_in_production"

# Port for the Express server to listen on
PORT=5000

# URL of the deployed frontend to configure CORS securely
FRONTEND_URL="http://localhost:5173"
